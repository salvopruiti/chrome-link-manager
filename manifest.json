{
  "manifest_version": 3,
  "name": "Link Manager",
  "version": "0.4.1",
  "description": "Manage locally saved links with seen/favorite states and optional Supabase sync.",
  "permissions": ["storage", "bookmarks", "tabs", "contextMenus", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "src/options.html",
  "web_accessible_resources": [
    {
      "resources": ["src/auth-callback.html", "src/auth-callback.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Link Manager",
    "default_popup": "src/popup.html"
  }
}
